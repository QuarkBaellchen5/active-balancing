			(embedded_fonts no)
		)
	)
	(text "Differenzverstärker\nDa R1 = R3 und R2 = R4 gilt:\nUa = R2/R1*(Ue2-Ue1) mit R2/R1 = 10\nSomit entsprich 1 A nun 0.1V *10 = 1V Spannungsdifferenz.\nEs muss somit kein Faktor Sofwareseitig berücksichtigt werden,\nsondern einfach mit dem Faktor 1 gerechnet werden."
		(exclude_from_sim no)
		(at 111.252 169.672 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "3c2a68b5-5b44-4acb-ac71-e89e9cc684ff")
	)
	(text "LM2596\nAnschlussschema siehe Datenblatt\n"
		(exclude_from_sim no)
		(at 198.882 22.606 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "3ccf9536-c912-4654-a355-4b73bf21a262")
	)
	(text "Integrator \nI-Anteil des Reglers"
		(exclude_from_sim no)
		(at 90.424 25.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "49db18ab-8fde-4d9e-a66e-2f71ea4d3e8b")
	)
	(text "Differenzverstärker mit Verstärkungsfaktor 1\nVergleicht die Sollvorgabe des DAC mit dem gemessenen Strom am Shunt.\nErzeugt eine Differenzspannung für den Regelkreis\n"
		(exclude_from_sim no)
		(at 51.308 16.764 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "84017a73-06d6-4936-9dc9-ff861acd6ef0")
	)
	(text "Verstärkung der Regelspannung\nDer Mosfet wird in seinem Teilleitenden Bereich betrieben.\nDurch den Variablen Widerstand kann das Verhältnis am LM2596 \nund damit der Ladestrom beeinflusst werden. (Siehe Simulation LT Spice)\n"
		(exclude_from_sim no)
		(at 139.192 19.812 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "902a504a-240a-4ae7-ad8e-1338d057547b")
	)
	(text "Spannungsversorgung OPV mit +-5V\n"
		(exclude_from_sim no)
		(at 34.29 110.744 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "c03a07c6-d211-4252-919b-4f5d45d11605")
	)
